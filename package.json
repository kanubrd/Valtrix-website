{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:skip-optimize": "next build",
    "build:vercel": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "analyze": "set ANALYZE=true && npm run build",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "postinstall": "echo 'Dependencies installed successfully'",
    "clean": "node -e \"['.next', 'out', 'dist', 'node_modules/.cache'].forEach(p => require('fs').rmSync(p, { recursive: true, force: true }))\"",
    "clean:all": "node -e \"['.next', 'out', 'dist', 'node_modules'].forEach(p => require('fs').rmSync(p, { recursive: true, force: true }))\"",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@studio-freight/lenis": "1.0.42",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.39.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "nodemailer": "9.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^17.0.0",
    "react-intersection-observer": "^10.0.3",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  }
}
